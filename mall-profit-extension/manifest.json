{
  "manifest_version": 3,
  "name": "商店利润筛选器",
  "version": "1.11.0",
  "description": "在鸢尾花商城和 SMCShop 上筛选正利润物品，点击商品名可直接跳转到物品详情；鸢尾花商城另支持异常价格过滤、原版/非原版和港口黑名单。",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://mall.vesego.xyz/*",
    "https://shop.whalemc.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mall.vesego.xyz/*",
        "https://shop.whalemc.com/*"
      ],
      "js": [
        "profit-core.js",
        "site-adapters.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
